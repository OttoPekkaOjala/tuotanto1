<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="tuotanto1.Views.MainPage"
    BackgroundColor="#121212">

    <Grid ColumnDefinitions="200, *" Padding="10">

        <!-- VASEN VALIKKO -->
        <VerticalStackLayout Spacing="12" Grid.Column="0">

            <!-- Asiakkaat -->
            <Button Text="Asiakkaat"
                    Clicked="Asiakkaat_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <!-- Mökit -->
            <Button Text="Mökit"
                    Clicked="Mokit_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <!-- Varaukset -->
            <Button Text="Varaukset"
                    Clicked="Varaukset_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <!-- Laskut -->
            <Button Text="Laskut"
                    Clicked="Laskut_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <!-- Raportit -->
            <Button Text="Raportit"
                    Clicked="Raportit_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

        </VerticalStackLayout>

        <!-- OIKEA PUOLI: TERVETULOA -->
        <VerticalStackLayout Grid.Column="1"
                             VerticalOptions="Center"
                             HorizontalOptions="Center">

            <Label Text="Tervetuloa Vuokraamo-sovellukseen"
                   TextColor="White"
                   FontSize="28"
                   HorizontalOptions="Center" />

            <Label Text="Valitse toiminto vasemmalta"
                   TextColor="#CCCCCC"
                   FontSize="16"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
