<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:tuotanto1.ViewModels"
             x:Class="tuotanto1.Views.RaportitPage"
             Title="Raportit">

    <ContentPage.BindingContext>
        <viewmodels:RaportointiViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Laskuraportti"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Laskut}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#cccccc" Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding LaskuId}" FontAttributes="Bold" />
                            <Label Text="{Binding Summa, StringFormat='Summa: {0:C}'}" />
                            <Label Text="{Binding Alv, StringFormat='ALV: {0:C}'}" />
                            <Label Text="{Binding Maksettu, StringFormat='Maksettu: {0}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Frame BorderColor="#333" Padding="10" Margin="10">
            <Label Text="{Binding Kokonaissumma, StringFormat='Kokonaissumma: {0:C}'}"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </Frame>

        <Button Text="Päivitä raportit"
                Command="{Binding LataaRaportitAsync}"
                BackgroundColor="#0078D7"
                TextColor="White"
                CornerRadius="8"
                Padding="10" />

    </VerticalStackLayout>
</ContentPage>
