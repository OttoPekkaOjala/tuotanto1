<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="tuotanto1.Views.AsiakasPage"
    BackgroundColor="#121212">

    <Grid ColumnDefinitions="200, *" Padding="10">

        <!-- VASEN VALIKKO -->
        <VerticalStackLayout Spacing="12" Grid.Column="0">

            <Button Text="Lataa asiakkaat"
                    Clicked="Lataa_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState>
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button Text="Lisää asiakas"
                    Clicked="Lisaa_Clicked"
                    BackgroundColor="#1E1E1E"
                    TextColor="White"
                    CornerRadius="6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState>
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#333333"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

            </Button>

        </VerticalStackLayout>

        <!-- OIKEA LISTA -->
        <CollectionView Grid.Column="1"
                        ItemsSource="{Binding Asiakkaat}"
                        Margin="10">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1E1E1E"
                           BorderColor="#333333"
                           CornerRadius="8"
                           Padding="10"
                           Margin="0,0,0,10">

                        <VerticalStackLayout>
                            <Label Text="{Binding Etunimi}" TextColor="White" FontSize="18"/>
                            <Label Text="{Binding Sukunimi}" TextColor="#CCCCCC"/>
                            <Label Text="{Binding Email}" TextColor="#888888" FontSize="12"/>
                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
