<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:tuotanto1.ViewModels"
             x:Class="tuotanto1.Views.AsiakasPage">

    <ContentPage.BindingContext>
        <viewmodel:AsiakasViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="15" BackgroundColor="Black">

        <Entry Placeholder="Hae asiakasta..."
               Text="{Binding Hakusana}"
               TextChanged="OnSearchChanged"/>

        <Button Text="Lisää uusi asiakas"
                Command="{Binding LisaaAsiakasCommand}" />

        <CollectionView ItemsSource="{Binding Asiakkaat}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*,2*,Auto,Auto" Padding="5">

                        <Label Text="{Binding Nimi}" Grid.Column="0"/>
                        <Label Text="{Binding Sahkoposti}" Grid.Column="1"/>

                        <Button Text="Muokkaa"
                                Grid.Column="2"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AsiakasViewModel}}, Path=MuokkaaAsiakastaCommand}"
                                CommandParameter="{Binding}" />

                        <Button Text="X"
                                TextColor="Red"
                                Grid.Column="3"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AsiakasViewModel}}, Path=PoistaAsiakasCommand}"
                                CommandParameter="{Binding}" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
