<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tuotanto1.Views.MokkiPage"
             Title="Mökit">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Mökit"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Button Text="Lisää uusi mökki"
                Clicked="OnAddMokkiClicked"
                HeightRequest="45" />

        <!-- LISTA -->
        <CollectionView x:Name="MokitCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,5" CornerRadius="6" BackgroundColor="#333">
                        <HorizontalStackLayout Spacing="10">

                            <VerticalStackLayout>
                                <Label Text="{Binding Nimi}"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="{Binding Sijainti}"
                                       TextColor="LightGray" />
                            </VerticalStackLayout>

                            <Button Text="Muokkaa"
                                    Clicked="OnMuokkaaClicked"
                                    CommandParameter="{Binding}"
                                    HorizontalOptions="EndAndExpand" />

                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- LISÄYS / MUOKKAUSLOMAKE -->
        <Frame x:Name="LisaaFrame"
               IsVisible="False"
               Padding="15"
               CornerRadius="8"
               BackgroundColor="#222">

            <VerticalStackLayout Spacing="10">

                <Label Text="Lisää / Muokkaa mökkiä"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Entry x:Name="NimiEntry"
                       Placeholder="Mökin nimi"
                       TextColor="White"
                       PlaceholderColor="Gray" />

                <Entry x:Name="SijaintiEntry"
                       Placeholder="Sijainti"
                       TextColor="White"
                       PlaceholderColor="Gray" />

                <Button Text="Tallenna"
                        Clicked="OnTallennaClicked"
                        BackgroundColor="#555"
                        TextColor="White" />

                <Button Text="Peruuta"
                        Clicked="OnPeruutaClicked"
                        BackgroundColor="#444"
                        TextColor="White" />

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>

</ContentPage>
