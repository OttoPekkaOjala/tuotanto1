<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tuotanto1.Views.MokkiPage"
             Title="Mökit">

    <Grid ColumnDefinitions="*,*" ColumnSpacing="30" Padding="20">

        <!-- VASEN: HAKU JA LISTA -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="10">

            <Label Text="Mökit" FontSize="24" FontAttributes="Bold" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry x:Name="HakuEntry" Placeholder="Hae mökin nimellä, alueella tai osoitteella" Completed="OnHaeClicked" />
                <Button Grid.Column="1" Text="Hae" Clicked="OnHaeClicked" />
            </Grid>

            <CollectionView x:Name="MokkiLista"
                            Grid.Row="2"
                            SelectionMode="Single"
                            SelectionChanged="OnValintaMuuttui">
                <CollectionView.EmptyView>
                    <Label Text="Ei mökkejä." Padding="8" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#444444" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Nimi}" FontAttributes="Bold" />
                            <Label Text="{Binding Lisatiedot}" TextColor="LightGray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- OIKEA: LISÄYS / MUOKKAUSLOMAKE -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Spacing="6">

                <Label x:Name="LomakeOtsikko" Text="Uusi mökki" FontSize="20" FontAttributes="Bold" />

                <Label Text="Alue *" />
                <Picker x:Name="AluePicker" Title="Valitse alue" ItemDisplayBinding="{Binding Nimi}"
                        TextColor="White" TitleColor="LightGray" BackgroundColor="#252525" />

                <Label Text="Mökin nimi *" />
                <Entry x:Name="NimiEntry" MaxLength="45" />

                <Label Text="Katuosoite" />
                <Entry x:Name="KatuosoiteEntry" MaxLength="45" />

                <Label Text="Postinumero *" />
                <Entry x:Name="PostinumeroEntry" MaxLength="5" Keyboard="Numeric" />

                <Label Text="Hinta / vrk (€) *" />
                <Entry x:Name="HintaEntry" Keyboard="Numeric" />

                <Label Text="Henkilömäärä *" />
                <Entry x:Name="HenkilomaaraEntry" Keyboard="Numeric" />

                <Label Text="Kuvaus" />
                <Entry x:Name="KuvausEntry" MaxLength="150" />

                <Label Text="Varustelu" />
                <Entry x:Name="VarusteluEntry" MaxLength="100" />

                <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                    <Button Text="Tallenna" Clicked="OnTallennaClicked" />
                    <Button Text="Tyhjennä / uusi" Clicked="OnUusiClicked" />
                    <Button x:Name="PoistaButton" Text="Poista" BackgroundColor="#8B0000"
                            IsEnabled="False" Clicked="OnPoistaClicked" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
